# --- Secrets (never commit .env) ---
FREELANCE_BOT_ENV=dev
FREELANCE_BOT_CONFIG=config.yaml

# Telegram bot for control panel and notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=  # Comma-separated list of admin chat IDs (e.g., 123456789,987654321)

# LLM (OpenAI-compatible endpoint; works with OpenAI, OpenRouter, local vLLM)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# CAPTCHA solving (optional; only used when a solver is reached)
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=

# Reader-relay for sites that block the server IP on TCP (fl.ru, freelance.ru).
# The free tier works without a key; a Jina key raises rate limits.
JINA_API_KEY=

# Russian residential proxy pool. Format:
#   http://user:pass@host:port,http://user:pass@host2:port
# Leave empty to run direct (datacenter IPs are blocked by Avito/Qrator).
RU_PROXY_URLS=

# Storage / output
FREELANCE_BOT_DB=var/freelance.db
FREELANCE_BOT_OUTBOX=var/outbox

# Persistent overrides written by Telegram commands (optional; default var/runtime_settings.yaml)
FREELANCE_BOT_OVERRIDES=var/runtime_settings.yaml
